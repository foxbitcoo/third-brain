{
  "name": "third-brain-local",
  "version": "0.3.0",
  "private": false,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/preflight.mjs --informational",
    "setup": "node scripts/setup-local.mjs",
    "start": "node scripts/start-local.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-release.mjs",
    "check:git": "node scripts/check-public-git.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "preflight": "node scripts/preflight.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "verify": "node scripts/verify-standalone.mjs",
    "test:context": "python3 -m unittest discover -s test -p \"*_test.py\"",
    "build": "npm run build --workspace apps/business-workbench",
    "prestart": "npm run build",
    "start:legacy": "node scripts/start-legacy.mjs",
    "test:workbench": "npm test --workspace apps/business-workbench"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "workspaces": [
    "apps/business-workbench"
  ]
}
