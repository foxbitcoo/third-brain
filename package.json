{
  "name": "third-brain-local",
  "version": "0.1.1",
  "private": false,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/preflight.mjs --informational",
    "setup": "node scripts/setup-local.mjs",
    "start": "node scripts/start-local.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-release.mjs",
    "check:git": "node scripts/check-public-git.mjs",
    "release:gate": "node scripts/release-gate.mjs",
