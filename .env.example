# 每个安装者必须创建自己的 WPS 开放平台应用。不要复制他人的凭证。
WPS_APP_ID=
WPS_APP_KEY=
WPS_REDIRECT_URI=http://127.0.0.1:4310/oauth/wps/callback
WPS_SCOPES=kso.user_base.read kso.mcp_message.readwrite

# 每位安装者使用自己的模型账号。支持 OpenAI-compatible Chat Completions 接口。
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 本地服务只监听回环地址。
LOCAL_PORT=4310

# 可选：仓库外的新版工作台扩展配置（仅本机，不上传）。
THIRD_BRAIN_WORKBENCH_CONFIG=
# 可选：独立数据存储目录；不填使用当前目录 .runtime/user-data。
THIRD_BRAIN_DATA_DIRECTORY=
# 可选：本人授权的 Bearer MCP 连接，未配置则查数显示未就绪。
DELPER_MCP_URL=
DELPER_MCP_TOKEN=
# 诊断模型独立凭据；不从私人凭据文件读取。
DEEPSEEK_API_KEY=
